<!-- Lightbox -->
<div id="lightboxModal" class="lightbox"><img id="lightboxImg" alt="Expanded"><span style="position:absolute; top:25px; right:35px; color:white; font-size:2.5rem; cursor:pointer;" id="closeLightbox">&times;</span></div>

<script>
  // ---------- CONFIGURABLE LINKS ----------
  const navLinksConfig = {
    aboutUs: "#", whereWeWork: "#", ourWork: "#", contactUs: "#"
  };
  const readMoreLinks = { story: "#", mission: "#", vision: "#" };
  const heroButtons = { joinUs: "#", donate: "#", jobs: "#", partner: "#" };
  const volunteerLink = "#", donateLink = "#", jobApplicationLink = "#";
  const socialLinks = {
    facebook: "https://www.facebook.com/oneafricaalliance",
    twitter: "https://twitter.com/oneafricaalliance",
    linkedin: "https://www.linkedin.com/company/oneafricaalliance",
    instagram: "https://www.instagram.com/oneafricaalliance"
  };

  function openLink(url) { if(url && url !== "#") window.open(url, '_blank'); else alert("Demo placeholder – replace with actual URL."); }

  // Nav & Footer links
  document.getElementById("navAboutUs")?.addEventListener("click", (e) => { e.preventDefault(); openLink(navLinksConfig.aboutUs); });
  document.getElementById("navWhereWeWork")?.addEventListener("click", (e) => { e.preventDefault(); openLink(navLinksConfig.whereWeWork); });
  document.getElementById("navOurWork")?.addEventListener("click", (e) => { e.preventDefault(); openLink(navLinksConfig.ourWork); });
  document.getElementById("navContactUs")?.addEventListener("click", (e) => { e.preventDefault(); openLink(navLinksConfig.contactUs); });
  document.getElementById("footerAboutUs")?.addEventListener("click", (e) => { e.preventDefault(); openLink(navLinksConfig.aboutUs); });
  document.getElementById("footerWhereWeWork")?.addEventListener("click", (e) => { e.preventDefault(); openLink(navLinksConfig.whereWeWork); });
  document.getElementById("footerOurWork")?.addEventListener("click", (e) => { e.preventDefault(); openLink(navLinksConfig.ourWork); });
  document.getElementById("footerContactUs")?.addEventListener("click", (e) => { e.preventDefault(); openLink(navLinksConfig.contactUs); });
  document.getElementById("readMoreStory")?.addEventListener("click", () => openLink(readMoreLinks.story));
  document.getElementById("readMoreMission")?.addEventListener("click", () => openLink(readMoreLinks.mission));
  document.getElementById("readMoreVision")?.addEventListener("click", () => openLink(readMoreLinks.vision));
  document.getElementById("joinUsBtn")?.addEventListener("click",()=>openLink(heroButtons.joinUs));
  document.getElementById("donateHeroBtn")?.addEventListener("click",()=>openLink(heroButtons.donate));
  document.getElementById("jobsHeroBtn")?.addEventListener("click",()=>openLink(heroButtons.jobs));
  document.getElementById("partnerHeroBtn")?.addEventListener("click",()=>openLink(heroButtons.partner));
  document.getElementById("donateSectionBtn")?.addEventListener("click",()=>openLink(donateLink));
  document.getElementById("jobApplyBtn")?.addEventListener("click",()=>openLink(jobApplicationLink));
  document.getElementById("volunteerBtn")?.addEventListener("click",()=>openLink(volunteerLink));
  document.querySelectorAll('.social-link').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const social = link.getAttribute('data-social');
      if (socialLinks[social]) window.open(socialLinks[social], '_blank');
      else alert("Social link not configured.");
    });
  });

  // Programs Data
  const programLinks = { disability: "#", environment: "#", widows: "#", elderly: "#", mental: "#", waste: "#", jobs: "#", youth: "#" };
  const programsData = [
    { title:"People With Disability Support", icon:"fas fa-wheelchair", desc:"Assistive tech, advocacy & inclusion.", img:"https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?w=600&q=80", linkKey:"disability" },
    { title:"Environmental Conservation", icon:"fas fa-leaf", desc:"Reforestation, clean energy, resilience.", img:"https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?w=600&q=80", linkKey:"environment" },
    { title:"Widows Support Care Network", icon:"fas fa-female", desc:"Economic empowerment & psychosocial aid.", img:"https://images.unsplash.com/photo-1532629345422-7515f3d16bb6?w=600&q=80", linkKey:"widows" },
    { title:"Elderly Care & Support", icon:"fas fa-hands", desc:"Healthcare, dignity & social inclusion.", img:"https://images.unsplash.com/photo-1581579438747-1dc8d17bbce4?w=600&q=80", linkKey:"elderly" },
    { title:"Mental Wellness Guidance", icon:"fas fa-brain", desc:"Counseling & mental health first aid.", img:"https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=600&q=80", linkKey:"mental" },
    { title:"Waste Connect Program", icon:"fas fa-recycle", desc:"Circular economy & waste management.", img:"https://images.unsplash.com/photo-1532996122724-e3c354a0b15b?w=600&q=80", linkKey:"waste" },
    { title:"Job Opportunities Program", icon:"fas fa-briefcase", desc:"Skills training & job placement.", img:"https://images.unsplash.com/photo-1521737711867-e3b97375f902?w=600&q=80", linkKey:"jobs" },
    { title:"Youth Empowerment Program", icon:"fas fa-graduation-cap", desc:"Leadership, tech & entrepreneurship.", img:"https://images.unsplash.com/photo-1523240795612-9a054b0db644?w=600&q=80", linkKey:"youth" }
  ];
  const programGrid = document.getElementById("programGrid");
  if(programGrid) {
    programsData.forEach(p => {
      const card = document.createElement("div"); card.className = "program-card";
      card.innerHTML = `<img src="${p.img}" loading="lazy" alt="${p.title}"><div class="program-body"><i class="${p.icon}" style="font-size:2rem;"></i><h3>${p.title}</h3><p>${p.desc}</p><button class="btn-primary learn-more" data-key="${p.linkKey}" style="padding:0.6rem 1.5rem;">Learn More →</button></div>`;
      programGrid.appendChild(card);
    });
    document.querySelectorAll(".learn-more").forEach(btn => btn.addEventListener("click", (e) => { const key = btn.dataset.key; openLink(programLinks[key] || "#"); }));
  }

  // Gallery
  const galleryImgs = [
    "https://images.unsplash.com/photo-1523805009345-8c3c5f9da6e1?w=600&q=80","https://images.unsplash.com/photo-1484406566174-3da6a566d0c7?w=600&q=80","https://images.unsplash.com/photo-1496200186974-4293800e2c20?w=600&q=80","https://images.unsplash.com/photo-1590846406792-0adc7f938f1d?w=600&q=80","https://images.unsplash.com/photo-1543269865-cbf427effbad?w=600&q=80","https://images.unsplash.com/photo-1523805009345-8c3c5f9da6e1?w=600&q=80","https://images.unsplash.com/photo-1573164574230-db1d5e960238?w=600&q=80","https://images.unsplash.com/photo-1509099836639-18ba1795216d?w=600&q=80","https://images.unsplash.com/photo-1569025743873-ea3a9ade89f9?w=600&q=80","https://images.unsplash.com/photo-1559128010-7c1ad6e1b6a5?w=600&q=80","https://images.unsplash.com/photo-1611510338559-2f463338092d?w=600&q=80","https://images.unsplash.com/photo-1531482615713-2afd69097998?w=600&q=80"
  ];
  const galleryDiv = document.getElementById("galleryGrid");
  galleryImgs.forEach(src => { const item = document.createElement("div"); item.className="gallery-item"; item.innerHTML=`<img src="${src}" loading="lazy" alt="Gallery">`; item.addEventListener("click",()=>{ document.getElementById("lightboxImg").src=src; document.getElementById("lightboxModal").classList.add("active"); }); galleryDiv.appendChild(item); });
  document.getElementById("closeLightbox")?.addEventListener("click",()=>document.getElementById("lightboxModal").classList.remove("active"));
  document.getElementById("lightboxModal")?.addEventListener("click",(e)=>{ if(e.target===document.getElementById("lightboxModal")) document.getElementById("lightboxModal").classList.remove("active"); });

  // Partners
  const partners = [
    { name:"African Union", logo:"https://placehold.co/160x80/0B7B6B/white?text=AU", website:"#" },{ name:"UNDP Africa", logo:"https://placehold.co/160x80/0B7B6B/white?text=UNDP", website:"#" },{ name:"Green Earth Org", logo:"https://placehold.co/160x80/0B7B6B/white?text=GEO", website:"#" },{ name:"Women Deliver", logo:"https://placehold.co/160x80/0B7B6B/white?text=WD", website:"#" },{ name:"YouthLead", logo:"https://placehold.co/160x80/0B7B6B/white?text=YL", website:"#" },{ name:"AfDB", logo:"https://placehold.co/160x80/0B7B6B/white?text=AfDB", website:"#" },{ name:"UNICEF Africa", logo:"https://placehold.co/160x80/0B7B6B/white?text=UNICEF", website:"#" },{ name:"Global Fund", logo:"https://placehold.co/160x80/0B7B6B/white?text=GF", website:"#" }
  ];
  const partnerGrid = document.getElementById("partnerGrid");
  partners.forEach(p=>{ const card=document.createElement("div"); card.className="partner-card"; card.innerHTML=`<img src="${p.logo}" alt="${p.name}"><p>${p.name}</p>`; card.addEventListener("click",()=>openLink(p.website)); partnerGrid.appendChild(card); });

  // Testimonials
  const testimonials = [
    { name:"Amina K.", role:"Community Leader", text:"One Africa Alliance transformed our village with clean water and education projects.", img:"https://randomuser.me/api/portraits/women/68.jpg" },
    { name:"John M.", role:"Youth Advocate", text:"Empowerment programs gave me skills to start my business and employ others.", img:"https://randomuser.me/api/portraits/men/32.jpg" },
    { name:"Grace N.", role:"Widow Beneficiary", text:"The support network changed my life, gave me hope and financial independence.", img:"https://randomuser.me/api/portraits/women/44.jpg" },
    { name:"David O.", role:"Environmental Officer", text:"Reforestation drive is impactful beyond measure — 187k trees planted!", img:"https://randomuser.me/api/portraits/men/55.jpg" },
    { name:"Esther W.", role:"Volunteer", text:"Volunteering with OAA is fulfilling and purpose-driven. I've seen real change.", img:"https://randomuser.me/api/portraits/women/90.jpg" },
    { name:"Michael A.", role:"Partner Director", text:"We've achieved scale thanks to their transparency and strategic execution.", img:"https://randomuser.me/api/portraits/men/22.jpg" }
  ];
  const track = document.getElementById("testimonialTrack");
  testimonials.forEach(t=>{ const slide=document.createElement("div"); slide.className="testimonial-card"; slide.innerHTML=`<img src="${t.img}" style="width:80px;height:80px;border-radius:50%;object-fit:cover;margin-bottom:1rem;"><h3>${t.name}</h3><p style="color:var(--primary-orange);">${t.role}</p><p>"${t.text}"</p>`; track.appendChild(slide); });
  const dotsContainer = document.getElementById("dotsContainer"); let currentSlide=0, slideInterval;
  for(let i=0;i<testimonials.length;i++){ const dot=document.createElement("div"); dot.classList.add("dot"); dot.dataset.index=i; dot.addEventListener("click",()=>{ currentSlide=i; updateSlider(); resetInterval(); }); dotsContainer.appendChild(dot);}
  function updateSlider(){ track.style.transform = `translateX(-${currentSlide*100}%)`; document.querySelectorAll(".dot").forEach((d,i)=>{ if(i===currentSlide) d.classList.add("active"); else d.classList.remove("active");}); }
  function nextSlide(){ currentSlide = (currentSlide+1)%testimonials.length; updateSlider(); }
  function resetInterval(){ if(slideInterval) clearInterval(slideInterval); slideInterval = setInterval(nextSlide, 5000);}
  updateSlider(); resetInterval();

  // Counters
  const counters = document.querySelectorAll('.counter'); let counted = false;
  const statSectionObs = document.querySelector('#statsContainer')?.closest('section');
  const counterObserver = new IntersectionObserver(entries=>{ entries.forEach(entry=>{ if(entry.isIntersecting && !counted){ counted=true; counters.forEach(c=>{ const target = +c.dataset.target; let current=0; const step = target/70; const interval = setInterval(()=>{ current+=step; if(current>=target){ c.innerText = target; clearInterval(interval); }else c.innerText = Math.floor(current); }, 20); }); } }); },{ threshold:0.4 });
  if(statSectionObs) counterObserver.observe(statSectionObs);

  // Scroll Reveal
  const revealElements = document.querySelectorAll('.reveal');
  const revealObserver = new IntersectionObserver((entries)=>{ entries.forEach(e=>{ if(e.isIntersecting) e.target.classList.add('active'); }); },{ threshold:0.1 });
  revealElements.forEach(el=>revealObserver.observe(el));

  // Mobile menu
  const hamburger = document.getElementById("hamburger"), navLinksDiv = document.getElementById("navLinks");
  hamburger?.addEventListener("click",()=> navLinksDiv.classList.toggle("active"));
  document.querySelectorAll(".nav-links a").forEach(link=> link.addEventListener("click",()=> navLinksDiv.classList.remove("active")));

  // News Updates
  const newsItems = [
    { title:"New Disability Tech Lab", desc:"Launched in Accra, empowering 500+ individuals", img:"https://images.unsplash.com/photo-1559027615-cd4628902d4a?w=600&q=80" },
    { title:"Green Campaign 2025", desc:"100k trees planted across the Sahel region", img:"https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?w=600&q=80" },
    { title:"Youth Summit Recap", desc:"Inspiring 2000 young leaders from 15 countries", img:"https://images.unsplash.com/photo-1523240795612-9a054b0db644?w=600&q=80" }
  ];
  const newsGridDiv = document.getElementById("newsGrid");
  newsItems.forEach(n=>{ const card=document.createElement("div"); card.className="program-card"; card.innerHTML=`<img src="${n.img}" loading="lazy" alt="${n.title}"><div class="program-body"><h3>${n.title}</h3><p>${n.desc}</p><i class="fas fa-calendar-alt"></i> March 2025</div>`; newsGridDiv.appendChild(card); });
</script>
</body>
