  <!-- Volunteer, Donate, Jobs -->
  <section><div class="container reveal"><div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:2rem;"><div class="card-icon"><i class="fas fa-hands-helping fa-3x"></i><h3>Volunteer With Us</h3><p>Build skills, create change, empower communities.</p><button class="btn-primary" id="volunteerBtn">Join Network</button></div><div class="card-icon"><i class="fas fa-donate fa-3x"></i><h3>Make a Donation</h3><div style="background:#e2e8f0; border-radius:30px; margin:1rem 0; height:8px;"><div style="width:74%; background:var(--primary-orange); height:8px; border-radius:30px;"></div></div><p>Goal $2.5M for rural schools — 74% funded</p><button class="btn-primary" id="donateSectionBtn">Donate Now</button></div><div class="card-icon"><i class="fas fa-bullhorn fa-3x"></i><h3>Job Opportunities</h3><p>Join our mission: multiple roles open</p><button class="btn-primary" id="jobApplyBtn">Apply Now</button></div></div></div></section>

  <!-- News & Updates -->
  <section style="background:var(--soft-gray);"><div class="container reveal"><h2 style="text-align:center;">News & Updates</h2><div class="news-grid" id="newsGrid"></div></div></section>
</main>

<!-- Footer - White background, well organized -->
<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col">
        <h4>One Africa Alliance</h4>
        <p>Uniting Africa, empowering futures. <br>Building sustainable communities across the continent.</p>
      </div>
      <div class="footer-col">
        <h4>Quick Links</h4>
        <a href="#" id="footerAboutUs">About Us</a><br>
        <a href="#" id="footerWhereWeWork">Where We Work</a><br>
        <a href="#" id="footerOurWork">Our Work</a><br>
        <a href="#" id="footerContactUs">Contact Us</a>
      </div>
      <div class="footer-col">
        <h4>Contact Info</h4>
        <p><i class="fas fa-map-marker-alt" style="color:var(--primary-orange); width: 24px;"></i> Nairobi, Kenya</p>
        <p><i class="fas fa-phone-alt" style="color:var(--primary-orange); width: 24px;"></i> +254 700 111 222</p>
        <p><i class="fas fa-envelope" style="color:var(--primary-orange); width: 24px;"></i> info@oneafricaalliance.org</p>
      </div>
      <div class="footer-col">
        <h4>Follow Us</h4>
        <div class="social-icons">
          <a href="#" class="social-link" data-social="facebook"><i class="fab fa-facebook-f"></i></a>
          <a href="#" class="social-link" data-social="twitter"><i class="fab fa-twitter"></i></a>
          <a href="#" class="social-link" data-social="linkedin"><i class="fab fa-linkedin-in"></i></a>
