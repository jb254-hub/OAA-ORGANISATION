  <meta property="og:title" content="One Africa Alliance | Uniting Africa for Sustainable Development">
  <meta property="og:description" content="Accelerating sustainable development across Africa through community empowerment, social support, and economic opportunity.">
  <meta property="og:type" content="website">
  <meta property="og:image" content="https://images.unsplash.com/photo-1523805009345-8c3c5f9da6e1?w=1200&h=630&fit=crop">
  <meta property="og:url" content="#">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="One Africa Alliance">
  <meta name="twitter:description" content="Building a united, prosperous, sustainable Africa.">
  <title>One Africa Alliance | Uniting Africa for Sustainable Development</title>
  <!-- Google Fonts + Font Awesome -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,300;14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    /* ---------- RESET & VARIABLES (Orange Theme) ---------- */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --primary-orange: #E67E22;
      --primary-orange-dark: #D35400;
      --primary-orange-light: #F39C12;
      --gold-accent: #F1C40F;
      --white: #FFFFFF;
      --soft-gray: #F8F9FC;
      --light-gray: #F1F5F9;
      --dark-text: #1E293B;
      --medium-text: #475569;
      --shadow-sm: 0 10px 25px -5px rgba(0,0,0,0.05);
      --shadow-md: 0 20px 35px -12px rgba(0,0,0,0.1);
      --shadow-lg: 0 25px 40px -12px rgba(0,0,0,0.15);
      --transition: all 0.4s cubic-bezier(0.2, 0.95, 0.4, 1);
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--white);
      color: var(--dark-text);
      line-height: 1.5;
      overflow-x: hidden;
    }

    h1, h2, h3, h4, .nav-links a, .btn {
      font-family: 'Poppins', sans-serif;
    }

    .container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    section {
      padding: 5rem 0;
    }

    /* Scroll Reveal */
    .reveal {
      opacity: 0;
      transform: translateY(50px);
      transition: opacity 0.9s ease, transform 0.9s ease;
    }
    .reveal.active {
      opacity: 1;
      transform: translateY(0);
    }

    /* Buttons */
    .btn-primary {
      background: linear-gradient(135deg, var(--primary-orange) 0%, var(--primary-orange-dark) 100%);
      color: white;
      padding: 0.9rem 2.2rem;
      border-radius: 50px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      box-shadow: 0 8px 18px rgba(230,126,34,0.3);
    }
    .btn-primary:hover {
      transform: translateY(-4px);
      box-shadow: 0 15px 25px rgba(230,126,34,0.4);
      background: linear-gradient(135deg, var(--primary-orange-dark) 0%, #a04000 100%);
    }
    .btn-outline {
      background: transparent;
      border: 2px solid var(--white);
      color: var(--white);
      padding: 0.85rem 2rem;
      border-radius: 50px;
      font-weight: 600;
      transition: var(--transition);
      backdrop-filter: blur(4px);
    }
    .btn-outline:hover {
      background: var(--primary-orange);
      border-color: var(--primary-orange);
      color: var(--white);
      transform: translateY(-3px);
    }
    .btn-readmore {
      background: transparent;
      border: 2px solid var(--primary-orange);
      color: var(--primary-orange);
      padding: 0.6rem 1.5rem;
      border-radius: 40px;
      font-weight: 600;
      transition: var(--transition);
      cursor: pointer;
      margin-top: 1rem;
      display: inline-block;
    }
    .btn-readmore:hover {
      background: var(--primary-orange);
      color: white;
      transform: translateY(-2px);
    }

    /* Sticky Navbar - White Background */
    .navbar {
      position: sticky;
      top: 0;
      background: var(--white);
      box-shadow: 0 2px 15px rgba(0,0,0,0.05);
      z-index: 1000;
      padding: 0.8rem 0;
      transition: 0.3s;
    }
    .nav-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 2rem;
    }
    .logo-img {
      height: 50px;
      width: auto;
      display: block;
    }
    .nav-links {
      display: flex;
      gap: 2rem;
      align-items: center;
    }
    .nav-links a {
      color: var(--dark-text);
      text-decoration: none;
      font-weight: 500;
      transition: 0.2s;
      font-size: 1rem;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .nav-links a i {
      font-size: 1.1rem;
      color: var(--primary-orange);
    }
    .nav-links a:hover { color: var(--primary-orange); transform: translateY(-2px); }
    .hamburger {
      display: none;
      font-size: 1.8rem;
      color: var(--dark-text);
      cursor: pointer;
    }
    /* Mobile Navigation - White background, well shaped */
    @media (max-width: 900px) {
      .nav-links {
        position: fixed;
        top: 75px;
        left: -100%;
        width: 280px;
        height: calc(100vh - 75px);
        background: var(--white);
        box-shadow: 5px 0 25px rgba(0,0,0,0.1);
        flex-direction: column;
        justify-content: flex-start;
        align-items: flex-start;
        padding: 2rem 1.8rem;
        transition: 0.3s ease;
        gap: 1.8rem;
        z-index: 999;
        border-radius: 0 20px 20px 0;
      }
      .nav-links.active {
        left: 0;
      }
      .nav-links a {
        font-size: 1.1rem;
        width: 100%;
        padding: 0.5rem 0;
      }
      .hamburger {
        display: block;
      }
    }

    /* Hero Section - Image background, dark overlay */
    .hero {
      background: url('https://images.unsplash.com/photo-1523805009345-8c3c5f9da6e1?w=1600&q=80') no-repeat center center/cover;
      min-height: 90vh;
      display: flex;
      align-items: center;
      color: white;
      position: relative;
    }
    .hero::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.55);
      z-index: 1;
    }
    .hero-content {
      position: relative;
      z-index: 2;
    }
    .hero-content h1 { font-size: 3.8rem; line-height: 1.2; margin-bottom: 1rem; font-weight: 700; text-shadow: 2px 2px 8px rgba(0,0,0,0.3); }
    .hero-tagline { font-size: 1.3rem; font-weight: 500; letter-spacing: -0.2px; text-shadow: 1px 1px 4px rgba(0,0,0,0.3);}
    .hero-buttons { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }

    /* About Cards */
    .about-cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      margin-top: 2rem;
    }
    .about-card {
      background: white;
      border-radius: 28px;
      overflow: hidden;
      box-shadow: var(--shadow-md);
      transition: var(--transition);
    }
    .about-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-lg); }
    .about-card img {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }
    .about-card-content {
      padding: 1.8rem;
    }
    .about-card-content h3 {
      font-size: 1.6rem;
      margin-bottom: 1rem;
      color: var(--primary-orange);
    }
    .about-card-content p {
      color: var(--medium-text);
      margin-bottom: 1.2rem;
    }

    /* Cards & Grids */
    .stat-grid, .program-grid, .why-grid, .news-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 2rem;
      margin-top: 3rem;
    }
    .card-icon {
      background: white;
      padding: 2rem 1.5rem;
      border-radius: 28px;
      box-shadow: var(--shadow-sm);
      transition: var(--transition);
      text-align: center;
      border: 1px solid rgba(0,0,0,0.02);
    }
    .card-icon:hover { transform: translateY(-10px); box-shadow: var(--shadow-md); }
    .card-icon i { color: var(--primary-orange); }
    
    /* Program Cards */
    .program-card {
      background: white;
      border-radius: 28px;
      overflow: hidden;
      transition: var(--transition);
      box-shadow: var(--shadow-sm);
    }
    .program-card img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      transition: transform 0.5s;
    }
    .program-card:hover { transform: translateY(-8px); box-shadow: var(--shadow-lg); }
    .program-card:hover img { transform: scale(1.05); }
    .program-body { padding: 1.5rem; }
    .program-body i { color: var(--primary-orange); }

    /* Gallery */
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem;
    }
    .gallery-item {
      overflow: hidden;
      border-radius: 24px;
      cursor: pointer;
      transition: 0.3s;
      box-shadow: var(--shadow-sm);
    }
    .gallery-item img {
      width: 100%;
      height: 260px;
      object-fit: cover;
      transition: transform 0.5s, filter 0.3s;
    }
    .gallery-item:hover img { transform: scale(1.08); filter: brightness(0.95); }

    /* Lightbox */
    .lightbox {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.92);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1100;
      visibility: hidden;
      opacity: 0;
      transition: 0.25s;
    }
    .lightbox.active { visibility: visible; opacity: 1; }
    .lightbox img { max-width: 90%; max-height: 85%; border-radius: 20px; }

    /* Testimonial Slider */
    .testimonial-slider {
      position: relative;
      max-width: 850px;
      margin: auto;
      overflow: hidden;
      border-radius: 32px;
    }
    .testimonial-track {
      display: flex;
      transition: transform 0.5s ease;
    }
    .testimonial-card {
      min-width: 100%;
      background: white;
      padding: 2.5rem;
      border-radius: 32px;
      text-align: center;
      box-shadow: var(--shadow-md);
    }
    .slider-dots { display: flex; justify-content: center; gap: 14px; margin-top: 2rem; }
    .dot { width: 12px; height: 12px; border-radius: 50%; background: #cbd5e1; cursor: pointer; transition: 0.2s; }
    .dot.active { background: var(--primary-orange); width: 32px; border-radius: 20px; }

    /* Partners Grid */
    .partner-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 2rem;
      align-items: center;
    }
    .partner-card {
      background: white;
      padding: 1.5rem;
      text-align: center;
      border-radius: 28px;
      transition: all 0.25s;
      cursor: pointer;
      box-shadow: var(--shadow-sm);
    }
    .partner-card:hover { transform: scale(1.05); background: #fff5e6; box-shadow: var(--shadow-md); }
    .partner-card img { max-width: 120px; height: auto; }

    /* Footer - White Background, Well Organized */
    footer {
      background: var(--white);
      color: var(--dark-text);
      padding: 3rem 0 2rem;
      border-top: 1px solid #e2e8f0;
      margin-top: 1rem;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 2.5rem;
      margin-bottom: 2rem;
    }
    .footer-col h4 {
      font-size: 1.2rem;
      margin-bottom: 1.2rem;
      color: var(--primary-orange);
      font-weight: 600;
    }
    .footer-col p, .footer-col a {
      color: var(--medium-text);
      text-decoration: none;
      line-height: 1.8;
      transition: 0.2s;
    }
    .footer-col a:hover {
      color: var(--primary-orange);
      transform: translateX(3px);
      display: inline-block;
    }
    .social-icons {
      margin-top: 0.5rem;
    }
    .social-icons a {
      color: var(--medium-text);
      margin-right: 1.2rem;
      font-size: 1.5rem;
      transition: var(--transition);
      display: inline-block;
    }
    .social-icons a:hover {
      color: var(--primary-orange);
      transform: translateY(-3px);
    }
    .copyright {
      text-align: center;
      padding-top: 2rem;
      border-top: 1px solid #e2e8f0;
      color: var(--medium-text);
      font-size: 0.9rem;
    }

    @media (max-width: 768px) {
      .hero-content h1 { font-size: 2.4rem; }
      .container { padding: 0 1.5rem; }
      section { padding: 3rem 0; }
      .footer-grid {
        gap: 1.5rem;
        text-align: center;
      }
      .social-icons a {
        margin: 0 0.8rem;
      }
    }
  </style>
</head>
<body>

<!-- Sticky Navigation with White Background and Icons -->
<nav class="navbar">
  <div class="nav-container">
    <img src="https://via.placeholder.com/180x60?text=One+Africa+Alliance" alt="One Africa Alliance Logo" class="logo-img" id="siteLogo">
