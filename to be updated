  <meta name="description" content="One Africa Alliance - Uniting Africa for sustainable development through community empowerment, social support, environmental stewardship, and inclusive growth.">
  <meta name="keywords" content="Africa, NGO, sustainable development, empowerment, community support, environmental conservation">
  <meta name="author" content="One Africa Alliance">
