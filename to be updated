            <button class="btn-readmore" id="readMoreStory"><i class="fas fa-arrow-right"></i> Read More</button>
          </div>
        </div>
        <div class="about-card">
          <img src="https://images.unsplash.com/photo-1543269865-cbf427effbad?w=600&q=80" alt="Our Mission" loading="lazy">
          <div class="about-card-content">
            <h3><i class="fas fa-bullseye"></i> Our Mission</h3>
            <p>Uniting Africa and accelerating sustainable development through community empowerment, social support, environmental stewardship, economic opportunity, and inclusive growth.</p>
            <button class="btn-readmore" id="readMoreMission"><i class="fas fa-arrow-right"></i> Read More</button>
          </div>
        </div>
        <div class="about-card">
          <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?w=600&q=80" alt="Our Vision" loading="lazy">
