  <!-- About Section: Story, Mission, Vision with images and Read More -->
  <section id="aboutSection">
    <div class="container reveal">
      <h2 style="font-size:2.6rem; text-align:center;">About <span style="color:var(--primary-orange);">Our Alliance</span></h2>
      <div class="about-cards">
        <div class="about-card">
          <img src="https://images.unsplash.com/photo-1523805009345-8c3c5f9da6e1?w=600&q=80" alt="Our Story" loading="lazy">
