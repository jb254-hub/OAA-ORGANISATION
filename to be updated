  </div>
</nav>

<main>
  <!-- Hero Section -->
  <section id="home" class="hero">
    <div class="container hero-content reveal">
      <h1>One Africa Alliance</h1>
      <p class="hero-tagline">Uniting Africa, Transforming Tomorrow</p>
