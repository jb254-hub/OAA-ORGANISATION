            <button class="btn-readmore" id="readMoreVision"><i class="fas fa-arrow-right"></i> Read More</button>
          </div>
        </div>
      </div>
      <!-- Core Values -->
      <div style="margin-top: 3rem;">
        <h3 style="text-align:center; font-size:1.8rem;">Core Values</h3>
        <div class="why-grid" style="margin-top:1.5rem;">
          <div class="card-icon"><i class="fas fa-hand-holding-heart fa-2x"></i><h4>Integrity</h4></div>
          <div class="card-icon"><i class="fas fa-globe-africa fa-2x"></i><h4>Unity</h4></div>
          <div class="card-icon"><i class="fas fa-leaf fa-2x"></i><h4>Sustainability</h4></div>
          <div class="card-icon"><i class="fas fa-users fa-2x"></i><h4>Inclusivity</h4></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Impact Statistics -->
  <section style="background:var(--soft-gray);">
    <div class="container reveal">
      <h2 style="text-align:center;">Our Impact in Numbers</h2>
      <div class="stat-grid" id="statsContainer">
        <div class="card-icon"><i class="fas fa-city fa-2x"></i><h3><span class="counter" data-target="342">0</span>+</h3><p>Communities Reached</p></div>
        <div class="card-icon"><i class="fas fa-graduation-cap fa-2x"></i><h3><span class="counter" data-target="12500">0</span>+</h3><p>Youth Empowered</p></div>
        <div class="card-icon"><i class="fas fa-briefcase fa-2x"></i><h3><span class="counter" data-target="8400">0</span>+</h3><p>Jobs Facilitated</p></div>
        <div class="card-icon"><i class="fas fa-tree fa-2x"></i><h3><span class="counter" data-target="187000">0</span>+</h3><p>Trees Planted</p></div>
        <div class="card-icon"><i class="fas fa-smile fa-2x"></i><h3><span class="counter" data-target="45800">0</span>+</h3><p>Beneficiaries Supported</p></div>
      </div>
    </div>
  </section>

  <!-- Programs Section -->
  <section id="programs">
    <div class="container reveal">
      <h2 style="text-align:center;">Flagship <span style="color:var(--primary-orange);">Programs</span></h2>
      <div class="program-grid" id="programGrid"></div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section style="background:white;">
    <div class="container reveal">
      <h2 style="text-align:center;">Why Choose One Africa Alliance</h2>
      <div class="why-grid">
        <div class="card-icon"><i class="fas fa-chart-line fa-2x"></i><h3>Transparency</h3><p>100% fund accountability</p></div>
        <div class="card-icon"><i class="fas fa-hand-peace fa-2x"></i><h3>Community Impact</h3><p>Local-led initiatives</p></div>
        <div class="card-icon"><i class="fas fa-recycle fa-2x"></i><h3>Sustainability</h3><p>Eco-conscious models</p></div>
        <div class="card-icon"><i class="fas fa-wheelchair fa-2x"></i><h3>Inclusivity</h3><p>No one left behind</p></div>
        <div class="card-icon"><i class="fas fa-lightbulb fa-2x"></i><h3>Innovation</h3><p>Tech-driven solutions</p></div>
        <div class="card-icon"><i class="fas fa-balance-scale fa-2x"></i><h3>Accountability</h3><p>Results-driven</p></div>
      </div>
    </div>
