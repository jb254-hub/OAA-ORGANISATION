      <a href="#" id="navWhereWeWork"><i class="fas fa-map-marker-alt"></i> Where We Work</a>
      <a href="#" id="navOurWork"><i class="fas fa-briefcase"></i> Our Work</a>
      <a href="#" id="navContactUs"><i class="fas fa-envelope"></i> Contact Us</a>
